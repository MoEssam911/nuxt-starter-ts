{
  "name": "nuxt-starter-ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --dotenv .env.development",
    "stg": "nuxt dev --dotenv .env.staging",
    "prod": "nuxt dev --dotenv .env.production",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run lint:fix && npm run format",
    "typecheck": "nuxi typecheck",
    "spellcheck": "cspell --gitignore --no-progress \"**/*.{ts,tsx,js,jsx,mjs,cjs,vue,md,mdx,json,yml,yaml}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run spellcheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.1.18",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "nuxt": "^4.4.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "cspell": "^10.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
