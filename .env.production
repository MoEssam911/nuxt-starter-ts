# API base URL
NUXT_PUBLIC_API_BASE=http://localhost:3001/api

# Auth (optional) - change to match your backend endpoints
NUXT_PUBLIC_AUTH_LOGIN_ENDPOINT=/api/auth/login
NUXT_PUBLIC_AUTH_LOGOUT_ENDPOINT=
NUXT_PUBLIC_AUTH_ME_ENDPOINT=/api/auth/me
NUXT_PUBLIC_AUTH_STORAGE=cookie
NUXT_PUBLIC_AUTH_SESSION_TIMEOUT=
NUXT_PUBLIC_AUTH_COOKIE_NAME=token

# App info
NUXT_PUBLIC_APP_NAME=Nuxt Starter
NUXT_PUBLIC_APP_ENV=production
